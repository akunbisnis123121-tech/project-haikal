/system identity
set name=R12

/ip address
add address=10.0.12.1/30 interface=ether1
add address=10.0.23.1/30 interface=ether2
add address=192.168.10.1/24 interface=ether4

/routing ospf instance
add name=ospf-v2 version=2 router-id=1.1.1.12

/routing ospf area
add name=backbone area-id=0.0.0.0 instance=ospf-v2

/routing ospf interface-template
add area=backbone networks=10.0.12.0/30
add area=backbone networks=10.0.23.0/30
